# --- Google Cloud / BigQuery ---
# Auth uses gcloud application-default credentials + service-account impersonation
# (this GCP org disables service-account key export, so no key file exists or is needed).
# Local setup:
#   gcloud auth application-default login --account <you>@example.com
#   gcloud config set auth/impersonate_service_account dlight-case-study@npd-01.iam.gserviceaccount.com
GCP_PROJECT_ID=npd-01
BQ_RAW_DATASET=dlight_raw
BQ_ANALYTICS_DATASET=dlight_analytics
BQ_IMPERSONATE_SERVICE_ACCOUNT=dlight-case-study@npd-01.iam.gserviceaccount.com
BQ_LOCATION=US

# There's also a `prod` dbt target (dlight_raw_prod / dlight_analytics_prod_*)
# -- see README's Environments section. Don't set DBT_TARGET or the *_prod
# dataset names here: prod is populated only by .github/workflows/ci.yml's
# deploy_prod job on push to main, never from a local .env.

# --- exchangerate-api.com ---
# Free tier key: https://www.exchangerate-api.com/ -> sign up -> dashboard
EXCHANGE_RATE_API_KEY=changeme

# --- Dagster ---
# Must be an ABSOLUTE path -- Dagster's instance bootstrapping resolves this
# relative to whatever the current process's CWD happens to be at the
# moment it's read, which is fragile (e.g. `make dagster` cd's into
# orchestration/ first). Point it at <repo_root>/orchestration/.dagster_home.
DAGSTER_HOME=/absolute/path/to/dlight-callcentre-analytics/orchestration/.dagster_home
